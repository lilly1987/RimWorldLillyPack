	<GeneDef ParentName="CheatsPresets">
		<defName>Speedster</defName>
		<label>Speedster</label>
		<description>Much faster movement, work and research, near-perfect melee dodging, and never fumbles aim or springs traps. With Odyssey: faster fishing and gravship piloting.</description>
		<iconPath>Genes/Icons/cheat</iconPath>
		<displayOrderInCategory>1</displayOrderInCategory>
		<statOffsets>
			<MoveSpeed>15</MoveSpeed>
			<WorkSpeedGlobal>9</WorkSpeedGlobal>
			<GeneralLaborSpeed>9</GeneralLaborSpeed>
			<ResearchSpeed>9</ResearchSpeed>
			<DoorOpenSpeed>9</DoorOpenSpeed>
			<BiosculpterOccupantSpeed>9</BiosculpterOccupantSpeed>
			<MeleeDodgeChance>1</MeleeDodgeChance>
			<MeleeCooldownFactor>-0.5</MeleeCooldownFactor>
			<AimingDelayFactor>-1</AimingDelayFactor>
			<TrapSpringChance>-1</TrapSpringChance>
			<FishingSpeed MayRequire="Ludeon.RimWorld.Odyssey">9</FishingSpeed>
			<PilotingAbility MayRequire="Ludeon.RimWorld.Odyssey">9</PilotingAbility>
		</statOffsets>
		<capMods>
			<li>
				<capacity>Manipulation</capacity>
				<offset>1</offset>
			</li>
			<li>
				<capacity>Moving</capacity>
				<offset>1</offset>
			</li>
		</capMods>
	</GeneDef>
	
