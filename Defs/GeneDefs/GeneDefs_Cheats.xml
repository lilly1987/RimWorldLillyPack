	<GeneDef ParentName="CheatsPresets">
		<defName>Super_Duper_Psychic</defName>
		<label>Super-Duper Psychic</label>
		<description>Huge psychic sensitivity and meditation gains, fast psychic entropy recovery, no entropy gain, and no mental breaks (psychic mood penalties scale up with sensitivity). Works with Vanilla Psycasts Expanded.</description>
		<iconPath>Genes/Icons/cheat</iconPath>
		<displayOrderInCategory>5</displayOrderInCategory>
		<statOffsets>
			<PsychicSensitivity>9</PsychicSensitivity>
			<MeditationFocusGain>9</MeditationFocusGain>
			<PsychicEntropyRecoveryRate>9</PsychicEntropyRecoveryRate>
			<PsychicEntropyGain>-1</PsychicEntropyGain>
			<MentalBreakThreshold>-1</MentalBreakThreshold>
			<PsychicRitualQualityOffset MayRequire="Ludeon.RimWorld.Anomaly">1</PsychicRitualQualityOffset>
