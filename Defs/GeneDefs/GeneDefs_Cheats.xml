	<GeneDef ParentName="CheatsPresets">
		<defName>Invulnerable</defName>
		<label>Invulnerable</label>
		<description>Takes no damage, heals and fights infection extremely fast, lives far longer, and is immune to the listed diseases and injuries, fire, toxins, food poisoning and extreme temperatures. With Odyssey: vacuum-proof. With Kraltech: nanite resistant.</description>
		<iconPath>Genes/Icons/cheat</iconPath>
		<displayOrderInCategory>3</displayOrderInCategory>
		<statOffsets>
			<IncomingDamageFactor>-1</IncomingDamageFactor>
			<InjuryHealingFactor>9</InjuryHealingFactor>
			<ImmunityGainSpeed>9</ImmunityGainSpeed>
			<PainShockThreshold>1</PainShockThreshold>
			<LifespanFactor>9</LifespanFactor>
			<ToxicEnvironmentResistance>1</ToxicEnvironmentResistance>
			<Flammability>-1</Flammability>
			<FoodPoisonChance>-1</FoodPoisonChance>
			<ComfyTemperatureMin>-99</ComfyTemperatureMin>
			<ComfyTemperatureMax>99</ComfyTemperatureMax>
			<VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">1</VacuumResistance>
			<HeatNullNaniteResistance MayRequire="blackmarket420.kraltechindustries">1</HeatNullNaniteResistance>
			<HeatNullNaniteEnvironmentResistance MayRequire="blackmarket420.kraltechindustries">1</HeatNullNaniteEnvironmentResistance>
			<ColdNullNaniteResistance MayRequire="blackmarket420.kraltechindustries">1</ColdNullNaniteResistance>
			<ColdNullNaniteEnvironmentResistance MayRequire="blackmarket420.kraltechindustries">1</ColdNullNaniteEnvironmentResistance>
			<RadiationResistance MayRequire="blackmarket420.kraltechindustries">1</RadiationResistance>
			<RadiationEnvironmentResistance MayRequire="blackmarket420.kraltechindustries">1</RadiationEnvironmentResistance>
			<AntiOrgToxinResistance MayRequire="blackmarket420.kraltechindustries">1</AntiOrgToxinResistance>
			<AntiOrgToxinEnvironmentResistance MayRequire="blackmarket420.kraltechindustries">1</AntiOrgToxinEnvironmentResistance>
			<RageVirusResistance MayRequire="blackmarket420.kraltechindustries">1</RageVirusResistance>
			<RageVirusEnvironmentResistance MayRequire="blackmarket420.kraltechindustries">1</RageVirusEnvironmentResistance>
		</statOffsets>
